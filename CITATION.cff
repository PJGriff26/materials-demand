cff-version: 1.2.0
title: "Materials Demand Model: Monte Carlo simulation of critical material demand and supply-chain risk for US energy infrastructure"
message: "If you use this software, please cite both the software (this file) and the associated manuscript when it is published."
type: software
authors:
  - family-names: Griffiths
    given-names: "P. J."
    affiliation: "Thayer School of Engineering, Dartmouth College"
